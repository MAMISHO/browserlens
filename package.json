{
  "name": "browserlens",
  "version": "0.1.0",
  "description": "Vision-focused MCP server for browser automation, timestamped screenshots, visual analysis, OCR, and image-to-Markdown through Ollama, OpenAI, or custom providers.",
  "type": "module",
  "bin": {
    "browserlens": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "docs",
    "browserlens-config.example.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc --emitDeclarationOnly && node scripts/bundle.mjs",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "playwright",
    "ollama",
    "ocr"
  ],
  "license": "MIT",
  "author": "",
  "dependencies": {
    "@automapper/core": "^9.0.2",
    "@automapper/pojos": "^9.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "tsyringe": "^4.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
