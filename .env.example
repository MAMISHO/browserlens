OLLAMA_BASE_URL=http://localhost:11434
VISION_PROVIDER=ollama
VISION_MODEL=qwen3-vl:8b
OCR_PROVIDER=ollama
OCR_MODEL=deepseek-ocr
BROWSERLENS_SCREENSHOT_DIR=
BROWSERLENS_HEADLESS=true
BROWSERLENS_USER_DATA_DIR=
BROWSERLENS_CHANNEL=

# Provider options: ollama, openai, custom.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
VISION_OPENAI_BASE_URL=
VISION_OPENAI_API_KEY=
VISION_OPENAI_MODEL=
OCR_OPENAI_BASE_URL=
OCR_OPENAI_API_KEY=
OCR_OPENAI_MODEL=

# Custom providers are internal or third-party services that expose a
# Chat Completions-compatible API but are not the public OpenAI API.
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_MODEL=
VISION_CUSTOM_BASE_URL=
VISION_CUSTOM_API_KEY=
VISION_CUSTOM_MODEL=
OCR_CUSTOM_BASE_URL=
OCR_CUSTOM_API_KEY=
OCR_CUSTOM_MODEL=
USE_CUSTOM_VISION=false
USE_CUSTOM_OCR=false

# BrowserLens does not run the main agent model itself.
# Use this note for your MCP client/agent configuration documentation.
# MAIN_AGENT_MODEL=deepseek-v4-flash-or-local-gemma
